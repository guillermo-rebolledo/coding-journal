# Neon pooled connection string (SSL required in production).
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Shared GitHub App credentials. Configure the callback URL as:
# http://localhost:3000/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# The public URL slug from https://github.com/apps/<slug>.
GITHUB_APP_SLUG=
# The GitHub App webhook secret used to verify delivery signatures.
GITHUB_WEBHOOK_SECRET=

# Authenticates Vercel Cron requests for finalization and privacy maintenance.
CRON_SECRET=

# Optional AI narrative. The deterministic journal remains available without it.
OPENAI_API_KEY=
OPENAI_SUMMARY_MODEL=gpt-5-mini-2025-08-07
OPENAI_INPUT_COST_PER_MILLION_USD=0
OPENAI_OUTPUT_COST_PER_MILLION_USD=0
SUMMARY_GLOBAL_DAILY_LIMIT=1000
SUMMARY_MONTHLY_SPEND_LIMIT_USD=100
SUMMARY_MAXIMUM_INPUT_BYTES=16000
SUMMARY_QUEUE_CONCURRENCY=5

# Optional service-protection tuning. Every value has a safe default; set one
# only to tighten or relax it for a deployment. See docs/operations.md.
RATE_LIMIT_JOURNAL_REFRESH=12
RATE_LIMIT_FINALIZATION_RETRY=5
RATE_LIMIT_NARRATIVE_REDACTION=20
RATE_LIMIT_ACCOUNT_DELETION=5
RATE_LIMIT_GITHUB_SYNC_DAILY=20000
CIRCUIT_FAILURE_THRESHOLD=5
CIRCUIT_FAILURE_WINDOW_SECONDS=300
CIRCUIT_COOLDOWN_SECONDS=120
WEBHOOK_QUEUE_CONCURRENCY=10
FINALIZATION_QUEUE_CONCURRENCY=5
# Optional. Defaults to BETTER_AUTH_SECRET; set it to rotate the opaque
# identifiers in logs without invalidating sessions.
TELEMETRY_SALT=
